# Copy to .env and fill in after the Azure setup guide (docs/azure-setup.md). Never commit .env.
TARIKH_MODE=live
# From the project's Home page in https://ai.azure.com
AZURE_AI_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
# The model that drafts, answers and (in regions without Content Understanding) reads papers
AZURE_AI_MODEL_DEPLOYMENT_NAME=tarikh-reader
# Deployments Content Understanding uses
TARIKH_CU_MINI_DEPLOYMENT=gpt-4.1-mini
TARIKH_CU_EMBEDDING_DEPLOYMENT=text-embedding-3-large
# model: the deployed vision model reads papers (Korea Central and other regions without Content Understanding)
# content_understanding: use Content Understanding analyzers where the region offers them
TARIKH_EXTRACTOR=model
